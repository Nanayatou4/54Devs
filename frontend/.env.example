# URL publique de l'API Spring (en local : http://localhost:8087/api)
VITE_API_BASE_URL=http://localhost:8087/api

# Identifiants OAuth publics utilisés pour construire les URLs de connexion
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Facultatif : par défaut, l'origine courante du navigateur est utilisée
# VITE_APP_ORIGIN=http://localhost:5173
